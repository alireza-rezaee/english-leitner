@using Microsoft.AspNetCore.Components.Authorization

<ConnectionView>
    <Online>
        <AuthorizeView>
            <Authorized>
                <MudFab OnClick="@SaveAsync" Color="@SyncColor" Variant="Variant.Text" Size="Size.Medium"
                        StartIcon="@SyncIcon" />
            </Authorized>
            <NotAuthorized>
                <MudFab Variant="Variant.Text" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.CloudOff"
                        Disabled="true" />
            </NotAuthorized>
        </AuthorizeView>
    </Online>
    <Offline>
        <MudFab Variant="Variant.Text" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.CloudOff"
                Disabled="true" />
    </Offline>
    <NoInternet>
        <MudFab Variant="Variant.Text" Size="Size.Medium" StartIcon="@Icons.Material.Outlined.CloudOff"
                Disabled="true" />
    </NoInternet>
</ConnectionView>

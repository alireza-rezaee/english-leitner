@using EnglishLeitner.WebClient.DTOs


<div class="review-calendar" style="max-width:750px;">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <MudText Typo="Typo.caption">
            @Title
        </MudText>
    }
    <MudSimpleTable Style="overflow-x: auto;" Bordered="false" Outlined="false">
        <tbody>
            @foreach (IGrouping<DayOfWeek, DateOnly> group in GroupedDateRange)
            {
                <tr>
                    @foreach (DateOnly date in group)
                    {
                        bool isInDateRange = date >= DateRange.Start && date <= DateRange.End;
                        if (isInDateRange)
                        {
                            ReviewCalendarItem? item = Items?.FirstOrDefault(x => x.Date == date);

                            string tooltip, cssClass;
                            if (item is not null)
                                (tooltip, cssClass) = (item.Tooltip, item.CssClass);
                            else
                            {
                                tooltip = $"No Review on {date:M}";
                                cssClass = "mud-theme-dark";
                            }

                            <td>
                                <MudTooltip Text="@tooltip">
                                    <div class="@cssClass rounded-sm review-state"></div>
                                </MudTooltip>
                            </td>
                        }
                        else
                        {
                            <td class="border-none"></td>
                        }
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</div>

@using WordModel = EnglishLeitner.EFDesign.Models.Word

<MudTable T="WordModel" ServerData="ServerReload" OnRowClick="@RowClickEvent" Hover="true" Breakpoint="Breakpoint.Sm"
          @ref="_table" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Words</MudText>
        <MudSpacer />
        <MudSwitch T="bool" Value="@_reviewsOnly" ValueChanged="@(x => OnReviewsOnlyChangedAsync(x))"
                   Label="Reviews only" Color="Color.Primary" Class="me-4" Size="Size.Small" />
        <MudTextField T="string" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="Search"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                      Class="mt-0"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.Id)" T="WordModel">
                @nameof(WordModel.Id)
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.HeadWord)" T="WordModel">
                Word
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.Position)" T="WordModel">
                @nameof(WordModel.Position)
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.Grammar)" T="WordModel">
                @nameof(WordModel.Grammar)
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.Cefr)" T="WordModel">
                @nameof(WordModel.Cefr)
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.Reviews)" T="WordModel">
                @nameof(WordModel.Reviews)
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(LastReviewKey)" T="WordModel"
                               InitialDirection="SortDirection.Descending">
                Last Review At
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="@nameof(WordModel.LeitnerLevel)" T="WordModel">
                Leitner Level
            </MudTableSortLabel>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@nameof(WordModel.Id)">@context.Id</MudTd>
        <MudTd DataLabel="@nameof(WordModel.HeadWord)" Style="text-transform: capitalize;">@context.HeadWord</MudTd>
        <MudTd DataLabel="@nameof(WordModel.Position)">@context.Position</MudTd>
        <MudTd DataLabel="@nameof(WordModel.Grammar)">@context.Grammar</MudTd>
        <MudTd DataLabel="@nameof(WordModel.Cefr)">@context.Cefr</MudTd>
        <MudTd DataLabel="@nameof(WordModel.Reviews)">
            @if (@context.Reviews.Count > 0)
            {
                @context.Reviews.Count
            }
            else
            {
                <text>No Review</text>
            }
        </MudTd>
        <MudTd DataLabel="@nameof(LastReviewKey)">
            @if (context.Reviews.Count > 0)
            {
                @context.Reviews.Max(x => x.Time).ToLocalTime()
            }
            else
            {
                <text>No Review</text>
            }
        </MudTd>
        <MudTd DataLabel="@nameof(WordModel.LeitnerLevel)">
            @foreach (var _ in Enumerable.Range(0, context.LeitnerLevel))
            {
                <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Success" />
            }
            @if (context.LeitnerLevel == 0)
            {
                if (context.Reviews.Any())
                {
                    <MudIcon Icon="@Icons.Material.Outlined.Cancel" Color="Color.Error" />
                }
                else
                {
                    <text>No Review</text>
                }
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No matching records found</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>Loading...</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@page "/words/{Slug}"

@using EFDesign.Models;

@if (_isLoading)
{
    <PageTitle>English Leitner</PageTitle>
    <MudText>Loading...</MudText>
}
else if (_model is null)
{
    <NotFound />
}
else
{
    <PageTitle>@_model.HeadWord • English Leitner</PageTitle>

    <div class="mt-2 d-flex justify-center">
        <MudPaper Width="750px" Style="max-width: 100%;">
            <MudCard Outlined="true" Style="min-height: calc(100vh - 90px);">
                <MudCardContent>
                    <div class="d-flex justify-space-between flex-grow-1 gap-4">
                        <MudButton OnClick="@GoBackHome" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.ArrowBackIosNew">
                            Home
                        </MudButton>
                        <MudButton OnClick="@GoBackHome" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.Outbox">
                            @_todayReviewsCount
                        </MudButton>
                    </div>
                    <div class="d-flex justify-space-between flex-grow-1 gap-4 mb-4">
                        <div class="d-flex flex-grow-1">
                            <div>
                                <MudText Typo="Typo.h3" Style="text-transform: capitalize;">
                                    @_model.HeadWord
                                </MudText>
                                <MudText Typo="Typo.body2">
                                    @foreach (string subtitle in _subtitleParts)
                                    {
                                        <MudText Typo="Typo.caption">@subtitle</MudText>

                                        if (subtitle != _subtitleParts.Last())
                                        {
                                            <MudText Typo="Typo.caption" Class="mx-2">•</MudText>
                                        }
                                    }
                                    @if (_subtitleParts.Length > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mx-2">•</MudText>
                                    }
                                    <MudLink Typo="Typo.caption" Href="@_model.WebPage" Target="_blank"
                                             EndIcon="@Icons.Material.Filled.OpenInNew">Oxford</MudLink>
                                </MudText>
                            </div>
                        </div>
                        <div class="d-flex align-content-center flex-wrap gap-0">
                            @if (_model.Pronunciations?.Count > 0)
                            {
                                IEnumerable<Pronunciation> pronunciations = _model.Pronunciations
                                    .Where(x => x.Mp3Url is not null)
                                    .OrderBy(x => x.Culture == Culture.EnUK);

                                @foreach (Pronunciation pronunciation in pronunciations)
                                {
                                    string culture = pronunciation.Culture == Culture.EnUK ? "UK" : "US";
                                    string tooltip = $"{culture}: {pronunciation.Phonetics}";
                                    Color color = pronunciation.Culture == Culture.EnUK ? Color.Info : Color.Error;

                                    <MudTooltip Text="@tooltip">
                                        <MudBadge Content="culture" Color="color" Overlap="true" Bordered="true"
                                                  Class="mt-3 me-4 mb-2 ms-1">
                                            <MudFab Color="color" StartIcon="@Icons.Material.Outlined.RecordVoiceOver"
                                                    Size="Size.Small"
                                                    onclick="@(async () => await PlayAudioAsync(pronunciation.Mp3Url!))" />
                                        </MudBadge>
                                    </MudTooltip>
                                }
                            }
                        </div>
                    </div>

                    <MudDivider />

                    <ReviewCalendar Items="@ReviewItems" DateRange="@_dateRange" Title="@ReviewCalendarTitle" />

                    <MudDivider />

                    <MudCollapse Expanded="@_isAnswerVisible">
                        <MudPaper Class="border px-2 py-2 mt-4">
                            <MudText Typo="Typo.body2">

                                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                                    @foreach (var group in _model.Meanings)
                                    {
                                        string? head = group.Head ?? _model.HeadWord!;

                                        <MudExpansionPanel Text="@head" Icon="@Icons.Material.Filled.MenuBook"
                                                           Expanded="true">
                                            <MudStack Spacing="2">

                                                @foreach (var meaning in group.Meanings)
                                                {
                                                    <MudCard Outlined="true" Class="pa-3">
                                                        <MudStack Spacing="2">

                                                            <div class="d-flex align-center flex-wrap gap-2">
                                                                @if (meaning.Number is not null)
                                                                {
                                                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled"
                                                                             Size="Size.Small">
                                                                        @meaning.Number
                                                                    </MudChip>
                                                                }

                                                                @if (meaning.Cefr is not null)
                                                                {
                                                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled"
                                                                             Size="Size.Small">
                                                                        @meaning.Cefr?.ToString().ToUpper()
                                                                    </MudChip>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(meaning.Grammar))
                                                                {
                                                                    <MudChip T="string" Color="Color.Secondary"
                                                                             Variant="Variant.Outlined" Size="Size.Small">
                                                                        @meaning.Grammar
                                                                    </MudChip>
                                                                }

                                                                @if (!string.IsNullOrWhiteSpace(meaning.Usage))
                                                                {
                                                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                                             Size="Size.Small" Icon="@Icons.Material.Filled.Info">
                                                                        @meaning.Usage
                                                                    </MudChip>
                                                                }
                                                            </div>

                                                            @if (!string.IsNullOrWhiteSpace(meaning.Definition))
                                                            {
                                                                <MudText Typo="Typo.body1" Class="font-weight-medium">
                                                                    @meaning.Definition
                                                                </MudText>
                                                            }

                                                            @if (!string.IsNullOrWhiteSpace(meaning.Variants))
                                                            {
                                                                <MudText Typo="Typo.body2">
                                                                    <strong>Variants:</strong> @meaning.Variants
                                                                </MudText>
                                                            }

                                                            @if (meaning.Examples?.Count > 0)
                                                            {
                                                                <MudPaper Class="pa-2" Elevation="0"
                                                                          Style="background-color: var(--mud-palette-background-grey);">
                                                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">
                                                                        Examples:
                                                                    </MudText>

                                                                    @if (meaning.Examples.Count > 0)
                                                                    {
                                                                        <ul class="ps-4">
                                                                            @foreach (Example example in meaning.Examples)
                                                                            {
                                                                                <li>
                                                                                    @if (!string.IsNullOrWhiteSpace(example.Description))
                                                                                    {
                                                                                        <strong>@example.Description</strong>
                                                                                    }
                                                                                    @if (!string.IsNullOrWhiteSpace(example.Text))
                                                                                    {
                                                                                        <text>@example.Text</text>
                                                                                    }
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                    }
                                                                </MudPaper>
                                                            }

                                                            @if (meaning.Refs?.Count > 0)
                                                            {
                                                                <MudStack Spacing="1">
                                                                    <MudText Typo="Typo.caption">References:</MudText>

                                                                    <MudChipSet T="string">
                                                                        @foreach (var reference in meaning.Refs)
                                                                        {
                                                                            if (!string.IsNullOrWhiteSpace(reference))
                                                                            {
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                                                                         Variant="Variant.Text" Icon="@Icons.Material.Filled.Link">
                                                                                    @reference
                                                                                </MudChip>
                                                                            }
                                                                        }
                                                                    </MudChipSet>
                                                                </MudStack>
                                                            }

                                                            @if (meaning.Topics?.Count > 0)
                                                            {
                                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                                    <MudText Typo="Typo.caption" Class="mr-2">Topics:</MudText>
                                                                    <MudChipSet T="string">
                                                                        @foreach (string topic in meaning.Topics)
                                                                        {
                                                                            if (!string.IsNullOrWhiteSpace(topic))
                                                                            {
                                                                                <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                                                         Variant="Variant.Outlined"
                                                                                         Icon="@Icons.Material.Filled.LocalOffer">
                                                                                    @topic
                                                                                </MudChip>
                                                                            }
                                                                        }
                                                                    </MudChipSet>
                                                                </MudStack>
                                                            }

                                                        </MudStack>
                                                    </MudCard>
                                                }

                                            </MudStack>
                                        </MudExpansionPanel>
                                    }
                                </MudExpansionPanels>


                            </MudText>
                        </MudPaper>
                    </MudCollapse>
                </MudCardContent>
                <MudCardActions>
                    <MudStack Style="width: 100%;">
                        @if (IsAnswerDisabled && _model.NextTryUTC is DateTime nextTryUtc)
                        {
                            DateTime nextTryTime = DateTime.SpecifyKind(nextTryUtc, DateTimeKind.Utc).ToLocalTime();
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                                It was reviewed recently. Please come back for the next review on
                                @nextTryTime.ToString("MMM dd HH:mm").
                            </MudAlert>
                        }
                        <MudButtonGroup FullWidth="true" OverrideStyles="false" Variant="Variant.Filled">
                            <MudButton Color="Color.Error" OnClick="@OnForgetAsync" Disabled="@IsAnswerDisabled"
                                       StartIcon="@Icons.Material.Filled.Close">
                                Forget
                            </MudButton>
                            <MudButton Color="Color.Info" OnClick="@ToggleAnswerDisplay"
                                       StartIcon="@(_isAnswerVisible ? @Icons.Material.Filled.VisibilityOff : @Icons.Material.Filled.Visibility)">
                                Answer
                            </MudButton>
                            <MudButton Color="Color.Success" OnClick="@OnRememberAsync" Disabled="@IsAnswerDisabled"
                                       StartIcon="@Icons.Material.Filled.Check">
                                Remember
                            </MudButton>
                        </MudButtonGroup>
                    </MudStack>
                </MudCardActions>
            </MudCard>
        </MudPaper>
    </div>
}

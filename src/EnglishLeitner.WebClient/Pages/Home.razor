@page "/"
@page "/words"

<PageTitle>English Leitner</PageTitle>

@if (_isLoading)
{
    @if (_isDbDownloading)
    {
        <MudText Typo="Typo.h6" Class="mt-5 mb-3" Style="text-align: center;">
            Initializing
        </MudText>

        <MudProgressLinear Color="Color.Info" Rounded="true" Striped="true" Size="Size.Large" Value="@_dbDownloadProgress"
                           Class="my-7">
            <MudText Typo="Typo.subtitle1" Color="Color.Default">
                <b>@_dbDownloadProgress.ToString("0.0")%</b>
                <MudText Typo="Typo.caption" Color="Color.Default">@_dbDownloadStatusMessage</MudText>
            </MudText>
        </MudProgressLinear>
    }
    else
    {
        <MudText>Loading...</MudText>
    }
}
else if (_isDbImported)
{
    <AvailableWordsAlert />

    <div class="d-flex justify-center flex-grow-1 gap-4 my-4">
        <MudPaper Width="750px" Class="pa-3" Style="max-width: 100%;">
            <ReviewCalendar Items="@ReviewItems" DateRange="@_dateRange" Title="@ReviewCalendarTitle" />
        </MudPaper>
    </div>

    <WordsTable DateRange="_dateRange" />
}

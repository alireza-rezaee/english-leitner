@page "/"
@page "/words"

@using DTOs
@using EnglishLeitner.EFDesign.Data
@using EnglishLeitner.WebClient.Settings
@using EnglishLeitner.WebClient.Services
@using EnglishLeitner.WebClient.Components
@using Microsoft.EntityFrameworkCore
@using SqliteWasmBlazor
@using static EnglishLeitner.WebClient.Services.DriveSyncService;

@implements IDisposable

@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ISyncService SyncService
@inject IConfiguration Configuration
@inject ILocalStorageService LocalStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISqliteWasmDatabaseService DbService
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Home | English Leitner</PageTitle>

@if (_isLoading)
{
    <MudText>Loading...</MudText>
}
else if (_isDbNotImported)
{
    <MudText Typo="Typo.h1" Style="text-align: center;">
        English Leitner
    </MudText>

    @if (_isDbDownloading)
    {
        <MudText Typo="Typo.h6" Class="mt-5 mb-3" Style="text-align: center;">
            Initializing
        </MudText>

        <MudProgressLinear Color="Color.Info" Rounded="true" Striped="true" Size="Size.Large" Value="@_dbDownloadProgress"
                           Class="my-7">
            <MudText Typo="Typo.subtitle1" Color="Color.Default">
                <b>@_dbDownloadProgress.ToString("0.0")%</b>
                <MudText Typo="Typo.caption" Color="Color.Default">
                    (@FormatBytes(_receivedBytes)/@FormatBytes(_totalBytes))
                </MudText>
            </MudText>
        </MudProgressLinear>
    }
}
else
{

    <MudText Typo="Typo.h1" Style="text-align: center;">
        English Leitner
    </MudText>

    <AvailableWordsAlert />

    <div class="d-flex justify-center flex-grow-1 gap-4 my-4">
        <MudPaper Width="750px" Class="pa-3" Style="max-width: 100%;">
            <ReviewCalendar Items="@ReviewItems" DateRange="@_dateRange" Title="@ReviewCalendarTitle" />
        </MudPaper>
    </div>

    <WordsTable DateRange="_dateRange" />

    <div class="d-flex justify-center flex-grow-1 gap-4 my-4">
        <MudButton OnClick="OnDeleteDatabaseAsync" StartIcon="@Icons.Material.Outlined.Delete" Size="Size.Small">Clean
            History</MudButton>
        </div>
    }


@code {
    const string DbName = "app.db";

    private bool _isLoading = true;
    private bool _isDbNotImported = false;
    private bool _isDbDownloading = false;
    private double _dbDownloadProgress = 0;
    private long _totalBytes = 0;
    private long _receivedBytes = 0;
    private DateOnlyRange _dateRange = null!;

    public Dictionary<DateOnly, int>? Model { get; set; }

    private ICollection<ReviewCalendarItem>? ReviewItems
    {
        get
        {
            return Model?
                .Select(x => (Date: x.Key, ReviewsCount: x.Value))
                .Select(x => new ReviewCalendarItem()
                {
                    Date = x.Date,
                    CssClass = "mud-theme-info" + x.ReviewsCount switch
                    {
                        > 75 => string.Empty,
                        > 50 => " opacity-75",
                        > 25 => " opacity-50",
                        > 0 => " opacity-25",
                        _ => string.Empty
                    },
                    Tooltip = $"{x.ReviewsCount} {(x.ReviewsCount > 1 ? "Reviews" : "Review")} on {x.Date:M}",
                }).ToList();
        }
    }

    private string ReviewCalendarTitle => Model?.Sum(x => x.Value) switch
    {
        > 1 => $"{Model?.Sum(x => x.Value)} Reviews",
        1 => "1 Review",
        0 or _ => "No Review",
    } + " in the last year";

    public static string GetRoute()
        => $"/";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadAsync();
            SyncService.OnSyncSucceeded += HandleSyncSucceeded;
        }
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _isLoading = true;
        await InvokeAsync(StateHasChanged);

        _dateRange = new DateOnlyRange(
            Start: DateOnly.FromDateTime(DateTime.Now.Date.AddYears(-1).AddDays(1)),
            End: DateOnly.FromDateTime(DateTime.Now.Date));

        try
        {
            _isDbNotImported = !await DbService.ExistsDatabaseAsync(DbName, cancellationToken);

            if (_isDbNotImported)
            {
                Task _ = Task.Run(async () =>
                {
                    await DownloadDatabaseAsync();
                    await LoadAsync();
                });
            }
            else
            {
                DateTime startTime = _dateRange.Start.ToDateTime(TimeOnly.MinValue, DateTimeKind.Local).ToUniversalTime();
                DateTime endTime = _dateRange.End.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Local).ToUniversalTime();

                await using ApplicationDbContext dbContext = await DbFactory.CreateDbContextAsync();
                List<DateTime> reviewTimes = await dbContext.Reviews
                    .Where(x => x.Time >= startTime && x.Time < endTime)
                    .Select(x => x.Time)
                    .ToListAsync();

                Model = reviewTimes
                    .GroupBy(utcTime =>
                        DateOnly.FromDateTime(
                            DateTime.SpecifyKind(utcTime, DateTimeKind.Utc).ToLocalTime()))
                    .ToDictionary(g => g.Key, g => g.Count());
            }

        }
        catch (Exception)
        {
            throw;
        }

        _isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0)
            return "0 B";

        string[] units = ["B", "KiB", "MiB", "GiB", "TiB"];

        var unitIndex = (int)Math.Floor(Math.Log(bytes, 1024));
        var value = bytes / Math.Pow(1024, unitIndex);

        return $"{value:0.##} {units[unitIndex]}";
    }

    private async Task OnDeleteDatabaseAsync()
    {
        bool isExists = await DbService.ExistsDatabaseAsync(DbName);
        if (!isExists)
            return;

        await LocalStorage.SetItemAsync<DateTime>(JsStorageKeyForClearHistoryTime, DateTime.UtcNow);
        await DbService.DeleteDatabaseAsync(DbName);
        await LoadAsync();
    }

    private async Task DownloadDatabaseAsync(bool force = false, CancellationToken cancellationToken = default)
    {
        _isDbDownloading = true;
        _dbDownloadProgress = 0;
        await InvokeAsync(StateHasChanged);

        try
        {
            bool isExists = await DbService.ExistsDatabaseAsync(DbName, cancellationToken);
            if (isExists && !force)
                return;

            ApplicationSettings appSettings = Configuration
                .GetRequiredSection("Application").Get<ApplicationSettings>()!;

            using HttpClient httpClient = HttpClientFactory.CreateClient("Application");
            using HttpRequestMessage request = new(HttpMethod.Get, appSettings.DatabaseUrl);
            using HttpResponseMessage response = await httpClient.SendAsync(
                request,
                HttpCompletionOption.ResponseHeadersRead);

            response.EnsureSuccessStatusCode();

            _totalBytes = response.Content.Headers.ContentLength ?? 0;

            await using Stream fileStream = await response.Content.ReadAsStreamAsync();
            await using MemoryStream memoryStream = new();

            byte[] buffer = new byte[64 * 1024]; // 64KB
            int count;
            _receivedBytes = 0;

            while ((count = await fileStream.ReadAsync(buffer.AsMemory(0, buffer.Length))) > 0)
            {
                await memoryStream.WriteAsync(buffer.AsMemory(0, count));

                _receivedBytes += count;

                if (_totalBytes > 0)
                    _dbDownloadProgress = (_receivedBytes * 100d) / _totalBytes;

                await InvokeAsync(StateHasChanged);
            }

            byte[] fileBytes = memoryStream.ToArray();
            _dbDownloadProgress = 100;

            if (isExists)
                await DbService.DeleteDatabaseAsync(DbName, cancellationToken);

            await DbService.ImportDatabaseAsync(DbName, fileBytes, cancellationToken);
        }
        catch (Exception ex)
        {
            if (!string.IsNullOrWhiteSpace(ex.Message))
                Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isDbDownloading = false;
            _dbDownloadProgress = default;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleSyncSucceeded()
            => LoadAsync();

    public void Dispose()
    {
        SyncService.OnSyncSucceeded -= HandleSyncSucceeded;
    }
}
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Outlined.Home" Color="Color.Inherit" Edge="Edge.Start"
                       Href="/" />
        <MudText Typo="Typo.h6" Class="ml-2">English Leitner</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggleAsync" />
        <DriveSyncButton />
        <GoogleAuthButton />
        <ConnectionView>
            <Offline>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error"
                         Icon="@Icons.Material.Outlined.SignalCellularConnectedNoInternet0Bar" IconColor="Color.Error">
                    Offline
                </MudChip>
            </Offline>
            <NoInternet>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning"
                         Icon="@Icons.Material.Outlined.SignalCellularConnectedNoInternet0Bar" IconColor="Color.Warning">
                    No
                    Internet
                </MudChip>
            </NoInternet>
        </ConnectionView>
        @* <MudFab Href="https://github.com/alireza-rezaee/english-leitner" Variant="Variant.Text"
                        StartIcon="@Icons.Material.Outlined.Info" Size="Size.Medium" /> *@
    </MudAppBar>

    <MudMainContent Class="pt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>
